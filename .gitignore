# Godot 4+ specific ignores
.godot/
*.translation

# Imported textures and metadata cache (regenerated by Godot on open)
# Note: .import and .uid files generated locally by Godot editor are safe to regenerate

# Export builds & binaries
build/
builds/
export/
exports/
*.apk
*.aab
*.apks
*.idsig
*.x86_64
*.exe
*.pck
*.dmg
*.app/

# Android Gradle build & signing secrets (NEVER commit credentials or keys)
android/build/
android/.gradle/
local.properties
export_presets.cfg
*.keystore
*.jks
*.pem
*.key
*.p12
*.env
.env
.env.*

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# OS / Editor files
.DS_Store
Thumbs.db
*~
*.swp
*.tmp
