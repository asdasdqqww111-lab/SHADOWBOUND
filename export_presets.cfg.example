; SHADOWBOUND — Android APK Export Preset Template (Godot 4.x stable)
; Copy this file to `export_presets.cfg` locally (git-ignored so signing
; keystore paths and passwords are NEVER committed to GitHub).
; Minimum target: Android 9.0 Pie (API 28) · Target SDK: Android 14 (API 34).
; Offline single-player: zero network permissions requested.

[preset.0]

name="Android APK"
platform="Android"
runnable=true
dedicated_server=false
custom_features="mobile"
export_filter="all_resources"
include_filter="*.json"
exclude_filter="assets/tools/*,tests/*,docs/*"
export_path="builds/android/SHADOWBOUND-v0.1.0.apk"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false

[preset.0.options]

custom_template/debug=""
custom_template/release=""
gradle_build/use_gradle_build=false
gradle_build/export_format=0
gradle_build/min_sdk="28"
gradle_build/target_sdk="34"
architectures/armeabi-v7a=true
architectures/arm64-v8a=true
architectures/x86=false
architectures/x86_64=false
version/code=1
version/name="0.1.0"
package/unique_name="com.shadowbound.rpg"
package/name="SHADOWBOUND"
package/signed=true
screen/immersive_mode=true
screen/support_small=true
screen/support_normal=true
screen/support_large=true
screen/support_xlarge=true
permissions/internet=false
permissions/access_network_state=false
